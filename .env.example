# --- Which model runs the system ---
# ollama        open-source models on this machine (no per-token cost)
# openai_compat any hosted service with an OpenAI-style chat API
# anthropic     Claude
LLM_PROVIDER=ollama

# Leave empty to use the provider's default.
#   ollama defaults:    qwen2.5-coder:7b (main), llama3.2:latest (fast)
#   anthropic defaults: claude-sonnet-5-5 (main), claude-haiku-5-5 (fast)
LLM_MODEL=
LLM_MODEL_FAST=
# The fast tier can use a different provider than the main tier.
LLM_PROVIDER_FAST=

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
# Context window. Prompts that would not fit are refused, because Ollama
# otherwise drops part of them without any error.
OLLAMA_NUM_CTX=8192

# --- Hosted OpenAI-compatible service (only for LLM_PROVIDER=openai_compat) ---
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# --- Claude (only for LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=

# --- Simulation ---
BASE_ECONOMY=US
MAX_RETRIES=3
MEMORY_ENABLED=true

# --- Market data ---
# Prices and headlines from Yahoo Finance, macro series from FRED. Free, no key.
# Every fetch is saved as a point-in-time snapshot under SNAPSHOT_DIR.
MARKET_DATA_ENABLED=true
SNAPSHOT_DIR=

# --- Daily trading pipeline (paper trading: simulated orders only) ---
# Every value below is a conservative placeholder to be set by you. The numbers
# shown are the defaults; a number may be changed or its line removed, but not left empty.
# One ticker per line. Empty uses the built-in list in pipeline/universe.py.
UNIVERSE_FILE=
# Candidates kept by the screen each day (10 to 30 is the intended range).
PIPELINE_MAX_CANDIDATES=10
# A run stops and places nothing once its model calls have cost this many dollars.
PIPELINE_MAX_COST_USD=2.0

# Paper account
PAPER_INITIAL_CASH=100000
PAPER_SLIPPAGE_BPS=5

# Sizing: percent of equity risked on a new position at full confidence, and
# how many ATRs below the last close its stop sits.
SIZING_RISK_PCT=1.0
SIZING_STOP_ATR_MULTIPLE=2.0
# The analyst may propose a stop of its own. It is used only when it is between
# these many ATRs below the last close; otherwise the stop above is used.
SIZING_STOP_MIN_ATR_MULTIPLE=1.0
SIZING_STOP_MAX_ATR_MULTIPLE=4.0

# Risk limits, in percent of account equity unless they are counts.
RISK_MAX_POSITION_PCT=10
RISK_MAX_SECTOR_PCT=30
RISK_MAX_POSITIONS=10
RISK_MIN_CASH_PCT=10
RISK_MAX_TRADE_RISK_PCT=1.0
RISK_MAX_NEW_POSITIONS_PER_DAY=3
RISK_MAX_DAILY_TURNOVER_PCT=30
# Circuit breakers: no new buying after a day's loss or a drawdown this large.
RISK_DAILY_LOSS_LIMIT_PCT=3
RISK_MAX_DRAWDOWN_PCT=10
# Kill switch: set to 1, or create the file data_store/HALT, and no order is placed.
TRADING_HALT=

# --- Evaluation (python -m evaluation): measures past views and trades, decides nothing ---
# What views and the account are measured against.
EVALUATION_BENCHMARK=SPY
# How many times the account's buys are replaced by random picks from the same day's candidates.
EVALUATION_SIMULATIONS=1000
# Most lessons one evaluation writes when run with --lessons (each is a model call).
EVALUATION_MAX_LESSONS=5
# Show those lessons to the ticker analyst. Off unless set to true: turning it on
# changes what the analyst reads, and so what the pipeline decides.
PIPELINE_USE_LESSONS=false
PIPELINE_LESSONS_PER_TICKER=3

# --- Dashboard (python -m dashboard): a read-only web page over the journal ---
# It has no login. The default address serves this computer only; change it only on a network you trust.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# Where runs are recorded. Empty uses data_store/ inside the project.
JOURNAL_PATH=
RUNS_DIR=
EVALUATION_DIR=

# MODEL_NAME, MODEL_FAST and MCP_ENABLED from older versions are no longer read.
