# --- Which model runs the system ---
# ollama        open-source models on this machine (no per-token cost)
# openai_compat any hosted service with an OpenAI-style chat API
# anthropic     Claude
LLM_PROVIDER=ollama

# Leave empty to use the provider's default.
#   ollama defaults:    qwen2.5-coder:7b (main), llama3.2:latest (fast)
#   anthropic defaults: claude-sonnet-5-5 (main), claude-haiku-5-5 (fast)
LLM_MODEL=
LLM_MODEL_FAST=
# The fast tier can use a different provider than the main tier.
LLM_PROVIDER_FAST=

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
# Context window. Prompts that would not fit are refused, because Ollama
# otherwise drops part of them without any error.
OLLAMA_NUM_CTX=8192

# --- Hosted OpenAI-compatible service (only for LLM_PROVIDER=openai_compat) ---
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# --- Claude (only for LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=

# --- Simulation ---
BASE_ECONOMY=US
MAX_RETRIES=3
MEMORY_ENABLED=true

# --- Market data ---
# Prices and headlines from Yahoo Finance, macro series from FRED. Free, no key.
# Every fetch is saved as a point-in-time snapshot under SNAPSHOT_DIR.
MARKET_DATA_ENABLED=true
SNAPSHOT_DIR=

# MODEL_NAME, MODEL_FAST and MCP_ENABLED from older versions are no longer read.
